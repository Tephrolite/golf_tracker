{
  "name": "golf-track",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "dev": "set \"PATH=%SystemRoot%\\System32;%PATH%\" && concurrently -n web,api -c green,blue \"npm run dev -w @golf-track/web\" \"npm run dev -w @golf-track/api\"",
    "dev:web": "npm run dev -w @golf-track/web",
    "dev:api": "npm run dev -w @golf-track/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @golf-track/api",
    "db:migrate": "npm run db:migrate -w @golf-track/api",
    "db:studio": "npm run db:studio -w @golf-track/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}